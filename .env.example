# ---- Backend ----
# Shared secret n8n must send as header `x-webhook-secret` when calling /webhook/n8n
N8N_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Optional: LLM provider for extracting messy PDFs/HTML (pipeline/extract.py::LLMExtractor)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: production data store (the demo uses SQLite + data/exams.json)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Web (only needed if you switch from the static JSON to a live API) ----
# NEXT_PUBLIC_API_BASE=http://localhost:8000
