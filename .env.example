# ---- Backend ----
# Shared secret n8n must send as header `x-webhook-secret` when calling /webhook/n8n
N8N_WEBHOOK_SECRET=change-me-to-a-long-random-string

# LLM provider = OpenRouter — powers AI extraction + the AI assistant (/ai/ask, /ai/digest).
# Set the key to turn AI on; without it the app runs on deterministic fallbacks (still works).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini   # fast+cheap; e.g. google/gemini-2.0-flash-001, anthropic/claude-3.5-haiku
# OPENROUTER_REFERER=https://exampath.app

# ---- Supabase (durable data store + API) ----
# The pipeline upserts each published run to Supabase and appends a snapshot;
# the website can build from the latest snapshot. See db/supabase_schema.sql
# and SUPABASE.md for the one-time setup.
SUPABASE_URL=https://nivelgmrbdinroqglalj.supabase.co
# Public/publishable key — safe to expose (read-only under RLS). Used by the
# website's build-time fetch and any client reads.
SUPABASE_ANON_KEY=sb_publishable_wDkuWCjBBVOpcY6jYkPuLQ_biahD_96
# SERVICE-ROLE key — SECRET. Never commit it; add it as a GitHub Actions secret
# named SUPABASE_SERVICE_KEY. Required for the pipeline to WRITE to Supabase.
SUPABASE_SERVICE_KEY=

# ---- Web (only needed if you switch from the static JSON to a live API) ----
# NEXT_PUBLIC_API_BASE=http://localhost:8000
