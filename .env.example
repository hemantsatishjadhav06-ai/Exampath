# ---- Backend ----
# Shared secret n8n must send as header `x-webhook-secret` when calling /webhook/n8n
N8N_WEBHOOK_SECRET=change-me-to-a-long-random-string

# LLM provider = OpenRouter — powers AI extraction + the AI assistant (/ai/ask, /ai/digest).
# Set the key to turn AI on; without it the app runs on deterministic fallbacks (still works).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini   # fast+cheap; e.g. google/gemini-2.0-flash-001, anthropic/claude-3.5-haiku
# OPENROUTER_REFERER=https://exampath.app

# Optional: production data store (the demo uses SQLite + data/exams.json)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Web (only needed if you switch from the static JSON to a live API) ----
# NEXT_PUBLIC_API_BASE=http://localhost:8000
